# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Loaded automatically by `npm start`.

# Admin password for taking control of the blimp.
ADMIN_PASSWORD=change-me

# Stripe. Both must be set or the Donate button hides itself.
# Test keys: https://dashboard.stripe.com/test/apikeys
# Live keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional. Defaults to 3000.
# PORT=3000
