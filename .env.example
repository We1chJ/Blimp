# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Loaded automatically by `npm start`.

# Admin password for taking control of the blimp.
ADMIN_PASSWORD=change-me

# Stripe. Both must be set or the Donate button hides itself.
# Test keys: https://dashboard.stripe.com/test/apikeys
# Live keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional. Defaults to 3000.
# PORT=3000

# Shared secret the blimp's firmware presents on the /device WebSocket.
# Without it the server refuses every device connection. Must match
# DEVICE_TOKEN_VALUE in firmware/motor_control/secrets.h.
# Generate one with: openssl rand -hex 32
DEVICE_TOKEN=
